{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "小六壬解卦台需要的权限：改窗口标题（自检用）+ 允许往模型接口发请求。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-title",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*" },
        { "url": "http://*" }
      ]
    }
  ]
}
